# LLM Provider Configuration
# The cheap model defaults to Gemini (gemini-1.5-flash) or OpenAI (gpt-4o-mini).
# Ensure to provide a valid API key. Placeholders like "CHANGE_ME" or "YOUR_" will fail validation.
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY

# Database Configuration
# Defaults to a file named 'eval.db' in the workspace root
DATABASE_PATH=eval.db

# Live Production Traffic Sampler Configuration
# Rate of sampling (e.g., 0.1 means sample 10% of requests)
SAMPLING_RATE=0.1
# Max allowed sampling rate (e.g. to prevent runaway cost under high traffic)
MAX_SAMPLING_RATE=0.5
# Kill switch: set to True/1 to completely disable live sampling
SAMPLER_KILL_SWITCH=False

# Regression Detector Config
# Score regression threshold (e.g. 0.05 means flag if quality degrades by >5%)
REGRESSION_THRESHOLD=0.05

# Alerts
ALERT_WEBHOOK_URL=http://localhost:8000/alert-webhook
